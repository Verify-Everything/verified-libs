+// crc32fast gate 1: a model of `ChunksExact` (the chunks not yet returned, and the remainder,
+// fixed when the iterator is made), and contracts for `chunks_exact` and `remainder` (std docs).
+pub trait ChunksExactExt<'a, T> {
+    #[logic]
+    fn chunks(self) -> Seq<&'a [T]>;
+
+    #[logic]
+    fn rem(self) -> &'a [T];
+}
+
+impl<'a, T> ChunksExactExt<'a, T> for ChunksExact<'a, T> {
+    #[logic(opaque)]
+    fn chunks(self) -> Seq<&'a [T]> {
+        dead
+    }
+
+    #[logic(opaque)]
+    fn rem(self) -> &'a [T] {
+        dead
+    }
+}
+
+impl<'a, T> IteratorSpec for ChunksExact<'a, T> {
+    #[logic(open, prophetic)]
+    fn completed(&mut self) -> bool {
+        pearlite! { resolve(self) && (*self).chunks() == Seq::empty() }
+    }
+
+    #[logic(open)]
+    fn produces(self, visited: Seq<Self::Item>, o: Self) -> bool {
+        pearlite! { self.chunks() == visited.concat(o.chunks()) && self.rem() == o.rem() }
+    }
+
+    #[logic(law)]
+    #[ensures(self.produces(Seq::empty(), self))]
+    fn produces_refl(self) {
+        let _ = Seq::<Self::Item>::concat_empty;
+    }
+
+    #[logic(law)]
+    #[requires(a.produces(ab, b))]
+    #[requires(b.produces(bc, c))]
+    #[ensures(a.produces(ab.concat(bc), c))]
+    fn produces_trans(a: Self, ab: Seq<Self::Item>, b: Self, bc: Seq<Self::Item>, c: Self) {
+        let _ = Seq::<Self::Item>::concat_assoc;
+    }
+}

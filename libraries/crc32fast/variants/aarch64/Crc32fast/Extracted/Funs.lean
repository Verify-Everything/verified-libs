    let (c02, c12, c22) ←
      specialized.aarch64.calculate_loop1 n3 a b c c01 c11 c21 i5
    let i6 ← lift (~~~ c02)
    let i7 ← lift (~~~ c12)
    let r1 ← combine.combine i6 i7 block_len
    let i8 ← lift (~~~ c22)
    let r2 ← combine.combine r1 i8 block_len

+// AENEAS PATCH: body of `PercentDecode::if_any`. The original
+// `while bytes_iter.any(|&b| b == b'%')` with an early `return` is rewritten
+// as a loop over the remaining slice with flags. `any` consumes bytes up to and
+// including the first `%`, so the iterator restarts just after it, as here.
+#[cfg(feature = "alloc")]
+fn decode_if_any(initial_bytes: &[u8]) -> Option<Vec<u8>> {
+    let mut rest = initial_bytes;
+    let mut result = None;
+    let mut done = false;
+    while !done {
+        match position_of_percent(rest) {
+            // Nothing to decode
+            None => done = true,
+            Some(i) => {
+                match decode_from_percent(initial_bytes, &rest[i + 1..]) {
+                    Some(decoded) => {
+                        result = Some(decoded);
+                        done = true;
+                    }
+                    // `after_percent_sign` failed and consumed nothing.
+                    None => rest = &rest[i + 1..],
+                }
+            }
+        }
+    }
+    result
+}

+// AENEAS PATCH: index of the first `%` in `bytes`, as a `while` loop.
+#[cfg(feature = "alloc")]
+fn position_of_percent(bytes: &[u8]) -> Option<usize> {
+    let mut i = 0;
+    while i < bytes.len() && bytes[i] != b'%' {
+        i += 1;
+    }
+    if i < bytes.len() {
+        Some(i)
+    } else {
+        None
+    }
